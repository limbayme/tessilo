# Set through the existing Sites runtime configuration before publishing.
# Do not commit actual secrets. A verified sender address is required.
RESEND_API_KEY=
INQUIRY_FROM=

# Shopify Headless Storefront API. Keep the token server-side only.
SHOPIFY_STORE_DOMAIN=tessilo-erkcvxa8.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Empty = quote-first. Comma-separated Shopify variant GIDs, approved only after
# price, inventory, destination shipping and return policies have been verified.
SHOPIFY_CHECKOUT_VARIANT_IDS=
